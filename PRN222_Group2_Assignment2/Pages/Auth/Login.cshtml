@page
@model PRN222_Group2_Assignment2.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card glass-panel shadow-lg border-0">
                <div class="card-body p-4 p-md-5">
                    <!-- Brand / Title -->
                    <div class="text-center mb-4">
                        <div class="brand-icon-box rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-cpu-fill fs-4"></i>
                        </div>
                        <h4 class="fw-bold text-white mb-1">RAG Syllabus Engine</h4>
                        <p class="fs-8 text-slate-400">Đăng nhập tài khoản hệ thống (Razor Pages)</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger fs-7 py-2.5 px-3 rounded-3 mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-6"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    }

                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <div class="mb-3">
                            <label class="form-label fs-7 fw-semibold text-slate-300">Email công vụ</label>
                            <div class="input-group">
                                <span class="input-group-text bg-slate-900 border-slate-800 text-slate-400"><i class="bi bi-envelope"></i></span>
                                <input type="email" asp-for="Input.Email" class="form-control bg-slate-900 border-slate-800 text-white fs-7" id="loginEmail" placeholder="admin@fe.edu.vn" required />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger fs-8 mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fs-7 fw-semibold text-slate-300">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-slate-900 border-slate-800 text-slate-400"><i class="bi bi-lock"></i></span>
                                <input type="password" asp-for="Input.Password" class="form-control bg-slate-900 border-slate-800 text-white fs-7" id="loginPassword" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger fs-8 mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fs-7 fw-semibold d-flex align-items-center justify-content-center gap-2 mb-4">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập hệ thống
                        </button>
                    </form>

                    <!-- Quick Fill Demo Credentials -->
                    <div class="border-top border-slate-800 pt-3 mt-2 text-center">
                        <div class="fs-8 text-slate-400 mb-2">Tài khoản thử nghiệm demo:</div>
                        <div class="d-flex justify-content-center gap-2">
                            <button type="button" class="btn btn-sm bg-slate-800 text-slate-300 border border-slate-700 fs-8 px-2.5 py-1 rounded-pill" onclick="fillLogin('leader@fe.edu.vn', '123456')">
                                <i class="bi bi-shield-check text-primary-accent me-1"></i> Subject Leader
                            </button>
                            <button type="button" class="btn btn-sm bg-slate-800 text-slate-300 border border-slate-700 fs-8 px-2.5 py-1 rounded-pill" onclick="fillLogin('student@fe.edu.vn', '123456')">
                                <i class="bi bi-person me-1"></i> Sinh viên
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillLogin(email, password) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }
    </script>
}
