<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Study Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-5" asp-page="/Document/Index">
                    <span class="brand-icon-box rounded-3 d-inline-flex align-items-center justify-content-center text-white">
                        <i class="bi bi-cpu-fill fs-5"></i>
                    </span>
                    <span>AI Study <span class="text-primary-accent">Hub</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2 d-flex align-items-center gap-2 active fw-semibold text-white btn-primary" asp-page="/Document/Index">
                                <i class="bi bi-folder-symlink-fill text-white"></i> Documents &amp; Indexing
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <div class="dropdown">
                                <button class="btn user-profile-btn dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1-5 fs-7" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar-sm rounded-circle text-white d-inline-flex align-items-center justify-content-center fw-bold" style="background-color: var(--signal-blue);">
                                        @(Context.Session.GetString("UserName")?[0] ?? 'U')
                                    </span>
                                    <span class="fw-semibold user-name">@Context.Session.GetString("UserName")</span>
                                    <span class="badge rounded-pill fs-8 ms-1" style="background: var(--signal-blue-subtle); color: #80b3ff; border: 1px solid var(--signal-blue-border);">@Context.Session.GetString("UserRole")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow-lg mt-2" aria-labelledby="userMenu">
                                    <li class="px-3 py-2 border-bottom border-slate-800">
                                        <div class="fw-semibold text-white">@Context.Session.GetString("UserName")</div>
                                        <div class="user-email fs-8">@Context.Session.GetString("UserEmail")</div>
                                    </li>
                                    <li>
                                        <form asp-page="/Auth/Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 py-2">
                                                <i class="bi bi-box-arrow-right"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm px-3 rounded-pill" asp-page="/Auth/Login">Sign In</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-body">
        <main role="main" class="pb-5">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="container-fluid px-4 mt-3">
                    <div class="alert alert-success alert-dismissible fade show bg-success-subtle text-success border-0 rounded-3 shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="container-fluid px-4 mt-3">
                    <div class="alert alert-danger alert-dismissible fade show bg-danger-subtle text-danger border-0 rounded-3 shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>