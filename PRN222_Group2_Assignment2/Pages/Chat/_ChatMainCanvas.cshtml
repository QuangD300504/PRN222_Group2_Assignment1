@model ChatWorkspaceViewModel
@{
    var userName = ViewData["UserName"] as string ?? "Bạn";
    var totalSources = Model.SourceDocuments.Count;
}

<!-- ── CENTER CONVERSATION CANVAS ────────────────────────────────────────────────── -->
<main class="chat-main" id="chatMain">
    <!-- Clean Chat Header -->
    <div class="chat-header px-4 py-2-5 d-flex align-items-center justify-content-between border-bottom border-slate-800 bg-slate-900/60 backdrop-blur">
        <div class="d-flex align-items-center gap-2 overflow-hidden">
            <span class="fs-6 fw-bold text-white text-truncate" id="chatHeaderTitle">@(Model.ActiveSession?.Title ?? "Cuộc trò chuyện mới")</span>
        </div>
    </div>

    <!-- Message Stream Area (Independent Scrollbar) -->
    <div class="chat-messages-container custom-scrollbar" id="chatMessages">
        @if (Model.ActiveMessages.Count == 0)
        {
            <!-- Hero Greeting (Empty State) -->
            <div class="chat-hero-state d-flex flex-column align-items-center justify-content-center text-center p-4 my-auto">
                <div class="hero-sparkle-icon mb-3">
                    <i class="bi bi-stars fs-1 text-primary-accent animate-pulse"></i>
                </div>
                <h3 class="fw-bold text-white mb-2">Đã đến lượt bạn hỏi, @userName!</h3>
                <p class="text-slate-400 fs-7 max-w-lg mb-4">
                    Đặt câu hỏi liên quan đến tài liệu môn học <strong>@Model.CurrentSubjectCode</strong>. 
                    AI sẽ chỉ trả lời dựa trên các tài liệu bạn đã chọn kèm trích dẫn chính xác.
                </p>

                <!-- Dynamic Context-Aware Starter Chips (Populated via JS based on selected sources) -->
                <div class="starter-chips d-flex flex-wrap gap-2 justify-content-center max-w-lg" id="starterChipsContainer">
                    <!-- Populated dynamically by renderDynamicStarterPrompts() -->
                </div>
            </div>
        }
        else
        {
            <!-- Render Existing Messages -->
            @foreach (var msg in Model.ActiveMessages)
            {
                if (msg.Role == "user")
                {
                    <div class="message-row user-row d-flex justify-content-end mb-3">
                        <div class="message-bubble user-bubble rounded-4 p-3 max-w-xl">
                            <div class="text-white fs-7 whitespace-pre-wrap">@msg.Content</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="message-row assistant-row d-flex justify-content-start mb-4">
                        <div class="assistant-avatar rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0">
                            <i class="bi bi-robot text-primary-accent fs-6"></i>
                        </div>
                        <div class="message-bubble assistant-bubble rounded-4 p-3-5 max-w-2xl border border-slate-800 bg-slate-900/80 shadow-sm">
                            <div class="markdown-body fs-7 text-slate-200" data-raw-content="@msg.Content">
                                @Html.Raw(msg.Content.Replace("\n", "<br/>"))
                            </div>

                            @if (msg.Citations != null && msg.Citations.Count > 0)
                            {
                                <div class="citations-bar mt-3 pt-2 border-top border-slate-800 d-flex flex-wrap align-items-center gap-1-5">
                                    <span class="fs-8 text-slate-400 fw-semibold me-1"><i class="bi bi-bookmarks text-emerald-400"></i> Nguồn trích dẫn:</span>
                                    @foreach (var cit in msg.Citations)
                                    {
                                        <button type="button" class="btn-citation-chip" 
                                                data-cit-index="@cit.Index"
                                                data-cit-title="@cit.DocumentTitle"
                                                data-cit-page="@cit.PageNumber"
                                                data-cit-heading="@cit.Heading"
                                                data-cit-snippet="@cit.Snippet"
                                                data-cit-score="@cit.SimilarityScore"
                                                onclick="handleCitationChipClick(this)">
                                            <span class="citation-circle">@cit.Index</span>
                                            <span class="text-truncate" style="max-width: 140px;">@cit.DocumentTitle</span>
                                            <span class="text-slate-400">· P.@cit.PageNumber</span>
                                        </button>
                                    }
                                </div>
                            }

                            @if (msg.SuggestedFollowUps != null && msg.SuggestedFollowUps.Count > 0)
                            {
                                <div class="followups-bar mt-3 pt-2 border-top border-slate-800/70 d-flex flex-column gap-1-5">
                                    <span class="fs-8 text-slate-400 fw-semibold"><i class="bi bi-lightbulb text-warning me-1"></i> Câu hỏi gợi ý tiếp theo:</span>
                                    <div class="d-flex flex-wrap gap-1-5">
                                        @foreach (var q in msg.SuggestedFollowUps)
                                        {
                                            <button type="button" class="btn-followup-chip" onclick="submitFollowUpPrompt(this)" data-prompt="@q">
                                                <span>@q</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
    </div>

    <!-- ── FLOATING INPUT ISLAND (ChatGPT & NotebookLM Style) ───────────────────────── -->
    <div class="chat-input-island-wrapper p-3">
        <div class="chat-input-island rounded-4 p-2 border border-slate-700/80 bg-slate-900/90 shadow-lg backdrop-blur d-flex flex-column">
            <textarea id="chatInput" class="form-control chat-textarea border-0 bg-transparent text-white fs-7 shadow-none" 
                      rows="1" placeholder="Đặt câu hỏi hoặc yêu cầu tóm tắt tài liệu..." 
                      oninput="autoResize(this)" onkeydown="handleKeyDown(event)"></textarea>

            <div class="d-flex align-items-center justify-content-between pt-2 px-2 border-top border-slate-800/60 mt-1">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-slate-800 text-slate-400 rounded-pill fs-8 d-flex align-items-center gap-1">
                        <i class="bi bi-file-earmark-check text-emerald-400"></i>
                        <span id="inputScopeBadge">@totalSources nguồn</span>
                    </span>
                    <span class="fs-9 text-slate-500 d-none d-sm-inline">Shift+Enter xuống dòng</span>
                </div>

                <button type="button" id="btnSendChat" class="btn btn-primary rounded-circle btn-send-arrow d-flex align-items-center justify-content-center p-0" 
                        onclick="submitChatQuestion()">
                    <i class="bi bi-arrow-up-short fs-4"></i>
                </button>
            </div>
        </div>
    </div>
</main>
