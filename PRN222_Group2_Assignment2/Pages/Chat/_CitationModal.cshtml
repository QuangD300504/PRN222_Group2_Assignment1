<!-- ── CITATION POPOVER MODAL ("Xem nguồn" Grounding Inspector) ──────────────────────── -->
<div class="modal fade" id="citationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border border-slate-700 bg-slate-900 text-white rounded-4 shadow-xl">
            <div class="modal-header border-bottom border-slate-800 py-3">
                <div class="d-flex align-items-center gap-2">
                    <span id="modalCitIndexBadge" class="citation-circle fs-7">1</span>
                    <h6 class="modal-title fw-bold text-truncate" id="modalCitDocTitle" style="max-width: 320px;">Tài liệu trích dẫn</h6>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="fs-8 text-slate-400 d-flex align-items-center flex-wrap gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded" id="modalCitChunkBadge">Chunk #1</span>
                        <span><i class="bi bi-file-text me-1"></i> Trang: <strong id="modalCitPage" class="text-slate-200">1</strong></span>
                        <span class="text-slate-600">·</span>
                        <span><i class="bi bi-bookmark me-1"></i> Mục: <strong id="modalCitHeading" class="text-slate-200">Tổng quan</strong></span>
                    </div>
                </div>

                <div class="p-3 rounded-3 bg-slate-950 border border-slate-800/80 text-slate-300 fs-7 line-relaxed custom-scrollbar font-monospace" style="max-height: 260px; overflow-y: auto;" id="modalCitSnippet">
                    Nội dung trích xuất từ tài liệu...
                </div>
            </div>
            <div class="modal-footer border-top border-slate-800 py-2">
                <button type="button" class="btn btn-sm btn-dark-glass rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
