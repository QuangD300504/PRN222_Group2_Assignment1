@page
@model PRN222_Group2_Assignment2.Pages.Document.IndexModel

@{
    ViewData["Title"] = "Quản lý Tài liệu & Indexing";
    var activeSubject = Model.ViewModel.Subjects.FirstOrDefault(s => s.Id == Model.ViewModel.SelectedSubjectId);
    var userRole = ViewContext.HttpContext.Session.GetString("UserRole") ?? "";
    var isSubjectLeader = string.Equals(userRole.Trim(), "SubjectLeader", StringComparison.OrdinalIgnoreCase);
}

@Html.AntiForgeryToken()

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0">Quản lý Tài liệu &amp; Embedded Chunks</h2>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (isSubjectLeader)
            {
                <button type="button" class="btn btn-slate-800 text-slate-300 border-slate-700 rounded-3 px-3 py-2 fw-semibold d-flex align-items-center gap-2" onclick="openManageSubjectModal()">
                    <i class="bi bi-gear-fill text-primary-accent fs-5"></i>
                    <span>Quản lý Môn &amp; Chương</span>
                </button>

                <button type="button" class="btn btn-primary bg-gradient-primary border-0 rounded-3 px-4 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <i class="bi bi-cloud-arrow-up-fill fs-5"></i>
                    <span>Tải lên tài liệu mới</span>
                </button>
            }
        </div>
    </div>

    <!-- Concurrent Editing Live Banner (SignalR) -->
    <div id="concurrentEditBanner" class="d-none alert alert-warning border-0 rounded-3 py-2 px-3 mb-3 d-flex align-items-center shadow-sm">
        <div class="d-flex align-items-center gap-2 fs-7">
            <span class="spinner-grow spinner-grow-sm text-warning" role="status"></span>
            <span id="concurrentEditMessage" class="text-warning-emphasis"></span>
        </div>
    </div>

    <!-- Subject Selection Pills & Create Subject Bar -->
    <div class="d-flex flex-column gap-2 mb-4 bg-slate-850 p-3 rounded-3 border border-slate-800">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-slate-400 fs-7 fw-medium me-2"><i class="bi bi-book-half text-primary-accent"></i> Môn học:</span>
                @foreach (var sub in Model.ViewModel.Subjects)
                {
                    var isSelected = Model.ViewModel.SelectedSubjectId == sub.Id;
                    var docCount = sub.Documents?.Count ?? 0;
                    <button type="button"
                            class="btn btn-sm rounded-pill px-3 py-1-5 fw-semibold transition-all @(isSelected ? "btn-primary bg-gradient-primary border-0 text-white shadow-sm" : "btn-slate-800 text-slate-300 border-slate-700 hover-slate-700")"
                            data-subject-id="@sub.Id"
                            onclick="switchSubject(@sub.Id)">
                        <span>@sub.Code</span>
                        <span class="doc-count opacity-75 ms-1 fs-8" id="subject-count-@sub.Id" data-count="@docCount">(@docCount)</span>
                    </button>
                }
            </div>

            @if (isSubjectLeader)
            {
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1-5 fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createSubjectModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Thêm môn học mới</span>
                </button>
            }
        </div>

        @{ var initDesc = activeSubject?.Description; }
        @{
            var hasInfo = activeSubject != null && (!string.IsNullOrWhiteSpace(activeSubject.Name) || !string.IsNullOrWhiteSpace(initDesc));
        }
        <div id="subjectDescCallout" class="@(hasInfo ? "" : "d-none ")d-flex align-items-start gap-2 border-top border-slate-800 pt-2 mt-1">
            <i class="bi bi-info-circle text-primary-accent flex-shrink-0" style="margin-top:2px"></i>
            <div>
                <div class="fw-semibold text-slate-200 fs-7">
                    <span class="badge bg-slate-800 text-primary-accent border border-slate-700 me-1 fs-8" id="subjectCodeBadge">@activeSubject?.Code</span>
                    <span id="subjectNameText">@activeSubject?.Name</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(initDesc))
                {
                    <div class="text-slate-400 fs-8 mt-0-5" id="subjectDescText">@initDesc</div>
                }
                @if (string.IsNullOrWhiteSpace(initDesc))
                {
                    <div class="text-slate-400 fs-8 mt-0-5 d-none" id="subjectDescText"></div>
                }
            </div>
        </div>
    </div>

    <!-- Partial region -->
    <div id="doc-partial-region">
        @await Html.PartialAsync("_DocumentTable", Model.ViewModel)
    </div>
</div>

@await Html.PartialAsync("_ChunksModal")
@await Html.PartialAsync("_UploadModal", Model.ViewModel)
<div id="manageSubjectModalRegion">
    @await Html.PartialAsync("_ManageSubjectModal", Model.ViewModel)
</div>

<!-- Create Subject Modal -->
<div class="modal fade" id="createSubjectModal" tabindex="-1" aria-labelledby="createSubjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-dark">
            <div class="modal-header border-bottom border-slate-800 px-4 py-3">
                <h5 class="modal-title fw-bold text-white fs-6 d-flex align-items-center gap-2" id="createSubjectModalLabel">
                    <i class="bi bi-journal-plus text-primary-accent"></i>
                    <span>Tạo Môn Học Mới</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="createSubjectAlert" class="alert alert-danger d-none rounded-3 fs-7 py-2 px-3"></div>
                <div class="mb-3">
                    <label class="form-label text-slate-300 fs-7 fw-medium">Mã Môn Học <span class="text-danger">*</span></label>
                    <input type="text" id="newSubjectCode" class="form-control form-control-dark" placeholder="Ví dụ: PRN222" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-slate-300 fs-7 fw-medium">Tên Môn Học <span class="text-danger">*</span></label>
                    <input type="text" id="newSubjectName" class="form-control form-control-dark" placeholder="Ví dụ: C# &amp; .NET Application Development" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-slate-300 fs-7 fw-medium">Mô tả Môn Học</label>
                    <textarea id="newSubjectDesc" class="form-control form-control-dark" rows="3" placeholder="Nhập mô tả môn học..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top border-slate-800 px-4 py-3">
                <button type="button" class="btn btn-slate-800 text-slate-300 border-slate-700 rounded-3 px-3 py-2 fs-7 fw-medium" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary bg-gradient-primary border-0 rounded-3 px-4 py-2 fs-7 fw-semibold" onclick="createSubjectSubmit()">Tạo Môn Học</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SignalR Library (LibMan) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script> 
    @* <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script> *@

    <!-- Runtime Document Config Bridge -->
    <script>
        window.DocConfig = {
            activeSubjectId: @(Model.ViewModel.SelectedSubjectId ?? 0),
            currentUserName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(HttpContext.Session.GetString("UserName") ?? "Subject Leader")),
            subjectDescriptions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ViewModel.Subjects.ToDictionary(s => s.Id.ToString(), s => new { code = s.Code, name = s.Name ?? "", desc = s.Description ?? "" })))
        };
    </script>

    <!-- External Document Management Client Script -->
    <script src="~/js/document.js" asp-append-version="true"></script>
}
    