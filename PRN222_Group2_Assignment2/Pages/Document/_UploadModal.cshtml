@model PRN222_Group2_Assignment1.ViewModels.DocumentManagementViewModel

<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-content-dark">
            <div class="modal-header py-3 px-4">
                <h5 class="modal-title fs-6 fw-bold text-white d-flex align-items-center gap-2" id="uploadModalLabel">
                    <i class="bi bi-cloud-arrow-up text-primary-accent"></i> Tải lên Giáo trình / Tài liệu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" id="uploadForm">
                <div class="modal-body p-4">
                    <!-- Dropzone upload box -->
                    <div class="upload-dropzone mb-4" id="dropzoneBox" onclick="document.getElementById('fileInput').click()">
                        <input type="file" name="File" id="fileInput" class="d-none" accept=".pdf,.docx,.doc,.pptx,.ppt" required onchange="handleFileSelected(this)" />
                        <div id="dropzoneContent">
                            <i class="bi bi-file-earmark-arrow-up fs-1 text-slate-400 d-block mb-2"></i>
                            <div class="fw-semibold text-white fs-7 mb-1">Kéo thả tài liệu vào đây hoặc <span class="text-primary-accent">Chọn tệp</span></div>
                            <div class="fs-8 text-slate-400">Hỗ trợ định dạng .PDF, .DOCX, .PPTX (Kích thước tối đa 50MB)</div>
                        </div>
                        <div id="selectedFileInfo" class="d-none">
                            <i class="bi bi-file-earmark-check fs-1 text-success d-block mb-2"></i>
                            <div class="fw-bold text-white fs-7 mb-0.5" id="fileNameDisplay"></div>
                            <div class="fs-8 text-slate-400" id="fileSizeDisplay"></div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold text-slate-300">Tên hiển thị tài liệu</label>
                            <input type="text" name="Title" class="form-control fs-7 bg-slate-900 border-slate-800 text-white" placeholder="VD: Syllabus PRN222 Summer 2026" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold text-slate-300">Môn học áp dụng</label>
                            <select name="SubjectId" id="uploadSubjectSelect" class="form-select fs-7 bg-slate-900 border-slate-800 text-white" required onchange="loadChaptersForUpload(this.value)">
                                <option value="">-- Chọn môn học --</option>
                                @foreach (var sub in Model.Subjects)
                                {
                                    <option value="@sub.Id">@sub.Code - @sub.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fs-7 fw-semibold text-slate-300">Chương / Chương trình (Tùy chọn)</label>
                            <select name="ChapterId" id="uploadChapterSelect" class="form-select fs-7 bg-slate-900 border-slate-800 text-white">
                                <option value="">-- Tất cả chương (Toàn bộ tài liệu) --</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2.5 px-4 bg-slate-900">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fs-7" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-3 px-4 fs-7 fw-semibold d-flex align-items-center gap-2">
                        <i class="bi bi-cpu-fill"></i> Tải lên & Trích xuất Chunks
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
