@model PRN222_Group2_Assignment1.ViewModels.DocumentManagementViewModel
@{
    var activeSubject = Model.Subjects.FirstOrDefault(s => s.Id == Model.SelectedSubjectId);
}

<!-- Modal 2: Upload Document -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content modal-content-dark">
            <div class="modal-header border-bottom border-slate-800 px-4 py-3">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="uploadModalLabel">
                    <i class="bi bi-cloud-arrow-up-fill text-primary-accent"></i> Tải lên &amp; Index Tài liệu Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="uploadAlert" class="d-none mb-3"></div>

                <!-- SignalR Real-Time Progress Bar -->
                <div id="uploadProgressContainer" class="d-none mb-3 p-3 bg-slate-850 rounded-3 border border-slate-700">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fs-8 fw-bold text-primary-accent d-flex align-items-center gap-1">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span id="uploadProgressTitle">Đang xử lý tài liệu...</span>
                        </span>
                        <span class="fs-8 fw-bold text-white" id="uploadProgressPercent">0%</span>
                    </div>
                    <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.08);">
                        <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-gradient-primary" role="progressbar" style="width: 0%"></div>
                    </div>
                    <div class="fs-8 text-slate-400 d-flex align-items-center gap-1" id="uploadProgressDetail">
                        <i class="bi bi-broadcast text-primary-accent"></i> <span id="uploadProgressMsg">Đang chuẩn bị...</span>
                    </div>
                </div>

                <div class="upload-dropzone mb-3" onclick="document.getElementById('fileInput').click()">
                    <input type="file" id="fileInput" class="d-none" accept=".pdf,.docx,.pptx" onchange="updateFilePreview(this)" />
                    <div id="dropzoneContent">
                        <i class="bi bi-cloud-upload text-primary-accent fs-1 mb-2 d-block"></i>
                        <h6 class="text-white fw-bold mb-1">Kéo thả file vào đây hoặc click để chọn</h6>
                        <p class="text-slate-400 fs-8 mb-0">Hỗ trợ PDF, DOCX, PPTX · Tối đa 25 MB</p>
                    </div>
                    <div id="selectedFileInfo" class="d-none">
                        <i class="bi bi-file-earmark-check-fill text-emerald-400 fs-1 mb-2 d-block"></i>
                        <div class="fw-bold text-white" id="selectedFileName">file.pdf</div>
                        <div class="text-slate-400 fs-8" id="selectedFileSize">0 MB</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-slate-300 fs-7 fw-semibold">Tên tài liệu / Tiêu đề</label>
                    <input type="text" id="docTitleInput" class="form-control fs-7" placeholder="Ví dụ: Slide Bài giảng Chương 1 EF Core..." />
                </div>

                <div class="mb-3">
                    <label class="form-label text-slate-300 fs-7 fw-semibold">Môn học</label>
                    <select id="uploadSubjectSelect" class="form-select fs-7" onchange="onUploadSubjectChange(this.value)">
                        @foreach (var sub in Model.Subjects)
                        {
                            var isSel = sub.Id == Model.SelectedSubjectId;
                            <option value="@sub.Id" data-desc="@(sub.Description ?? "")" selected="@isSel">@sub.Code – @sub.Name</option>
                        }
                    </select>
                    <div id="uploadSubjectDesc" class="text-slate-400 fs-8 mt-1">
                        @if (activeSubject != null && !string.IsNullOrWhiteSpace(activeSubject.Description))
                        {
                            <span><i class="bi bi-info-circle"></i> @activeSubject.Description</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-slate-300 fs-7 fw-semibold">Chương / Bài học</label>
                    <select id="chapterSelect" class="form-select fs-7" onchange="onChapterChange(this)">
                        <option value="">-- Toàn bộ môn học (không thuộc chương cụ thể) --</option>
                        @foreach (var ch in Model.Chapters)
                        {
                            <option value="@ch.Id">Ch.@ch.ChapterNumber – @ch.Title</option>
                        }
                        <option value="__new__">+ Tạo chương mới...</option>
                    </select>
                </div>

                <div id="newChapterForm" class="d-none p-3 bg-slate-850 rounded-3 border border-slate-700 mb-3">
                    <div class="text-slate-300 fs-7 fw-semibold mb-2 d-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle-fill text-primary-accent"></i> Tạo chương mới
                    </div>
                    <div class="row g-2">
                        <div class="col-3">
                            <label class="form-label text-slate-400 fs-8">Số chương</label>
                            <input type="number" id="newChapterNumber" class="form-control form-control-sm fs-8" min="1" placeholder="4" />
                        </div>
                        <div class="col-9">
                            <label class="form-label text-slate-400 fs-8">Tên chương</label>
                            <input type="text" id="newChapterTitle" class="form-control form-control-sm fs-8" placeholder="Ví dụ: Chapter 4: SignalR & Real-time Web" />
                        </div>
                    </div>
                    <div class="text-slate-500 fs-8 mt-2"><i class="bi bi-info-circle"></i> Nếu chương đã tồn tại (cùng số/tên), hệ thống sẽ tự động dùng lại.</div>
                </div>

            </div>
            <div class="modal-footer border-top border-slate-800 px-4 py-3">
                <button type="button" class="btn btn-slate-800 text-slate-300 border-slate-700 rounded-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="uploadSubmitBtn" class="btn btn-primary rounded-3 px-4 fw-semibold d-flex align-items-center gap-2" onclick="submitUpload()">
                    <i class="bi bi-cpu-fill"></i> Xử lý &amp; Index Document
                </button>
            </div>
        </div>
    </div>
</div>
