<div class="modal fade" id="manageSubjectModal" tabindex="-1" aria-labelledby="manageSubjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-dark">
            <div class="modal-header py-3 px-4">
                <h5 class="modal-title fs-6 fw-bold text-white d-flex align-items-center gap-2" id="manageSubjectModalLabel">
                    <i class="bi bi-journal-plus text-primary-accent"></i> Thêm Môn học mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateSubject">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fs-7 fw-semibold text-slate-300">Mã môn học (Subject Code)</label>
                        <input type="text" name="Code" class="form-control fs-7 bg-slate-900 border-slate-800 text-white font-monospace text-uppercase" placeholder="VD: PRN222" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-7 fw-semibold text-slate-300">Tên môn học đầy đủ</label>
                        <input type="text" name="Name" class="form-control fs-7 bg-slate-900 border-slate-800 text-white" placeholder="VD: Lập trình C# trên Windows (.NET Applications)" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-7 fw-semibold text-slate-300">Mô tả môn học (Tùy chọn)</label>
                        <textarea name="Description" class="form-control fs-7 bg-slate-900 border-slate-800 text-white" rows="3" placeholder="Mô tả nội dung chương trình môn học..."></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2.5 px-4 bg-slate-900">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fs-7" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-3 px-4 fs-7 fw-semibold d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i> Tạo Môn học
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
